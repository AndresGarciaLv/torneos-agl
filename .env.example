# ── PostgreSQL (única fuente de verdad) ──────────────────────────────
# En producción agrega ?sslmode=require (o verify-full) a la URL.
DATABASE_URL=postgres://monster:monster_dev_password@127.0.0.1:5432/monster_torneo

# ── Redis (caché, rate limiting, invalidación) ───────────────────────
# En producción usa rediss:// (TLS) y una contraseña fuerte.
REDIS_URL=redis://:monster_dev_redis@127.0.0.1:6379/0

# ── Administración ───────────────────────────────────────────────────
# Mínimo 12 caracteres. Nunca se envía al navegador.
ADMIN_PASSWORD=cambia-esta-contrasena-larga
# Mínimo 32 caracteres aleatorios. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=cambia-esto-por-un-secreto-aleatorio-de-48-bytes

# ── Público ──────────────────────────────────────────────────────────
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@monster_agl/live
# URL pública del sitio (Open Graph). En producción, el dominio real con https.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Correo (Brevo SMTP) ──────────────────────────────────────────────
# Sin SMTP_USER + SMTP_PASS + MAIL_FROM no sale ningún correo y la inscripción funciona igual.
# Los datos están en Brevo → SMTP & API → pestaña SMTP.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# El "Login" SMTP de Brevo (xxxxxx@smtp-brevo.com), NO el correo de tu cuenta.
SMTP_USER=
# La clave SMTP (xsmtpsib-...). Solo aquí, nunca en el código ni en el repo.
SMTP_PASS=
# Remitente. Tiene que estar verificado en Brevo → Senders, domains & dedicated IPs.
MAIL_FROM=Monster_AGL <torneos@tu-dominio.com>
# Quién recibe el aviso de cada inscripción.
ADMIN_NOTIFY_EMAIL=

# ── Opcionales ───────────────────────────────────────────────────────
# Torneo que muestra la landing (lo crea la migración 002).
# TOURNAMENT_SLUG=monster-agl-1v1-2026-09
# Proxies de confianza delante de la app que agregan su salto a X-Forwarded-For.
# 1 para Vercel o un Nginx; 2 para Cloudflare → Nginx. 0 desactiva la lectura de la IP.
# TRUSTED_PROXY_HOPS=1

# ── Docker Compose (solo desarrollo) ─────────────────────────────────
# Cambia los puertos del host si 5432/6379 ya están ocupados por otro proyecto,
# y ajusta DATABASE_URL / REDIS_URL para que apunten a ellos.
# POSTGRES_PORT=5432
# REDIS_PORT=6379
